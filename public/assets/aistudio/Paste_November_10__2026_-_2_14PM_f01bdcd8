<script>
  document.addEventListener('DOMContentLoaded', () => {
    // FAQ Accordion functionality
    const faqItems = document.querySelectorAll('.faq-item');
    
    faqItems.forEach(item => {
      const question = item.querySelector('.faq-question');
      const answer = item.querySelector('.faq-answer');
      const vertical = item.querySelector('.faq-vertical');
      
      if (!question || !answer) return;
      
      question.addEventListener('click', () => {
        const isOpen = item.classList.contains('active');
        
        // Close all other items
        faqItems.forEach(otherItem => {
          if (otherItem !== item && otherItem.classList.contains('active')) {
            otherItem.classList.remove('active');
            const otherAnswer = otherItem.querySelector('.faq-answer');
            const otherVertical = otherItem.querySelector('.faq-vertical');
            if (otherAnswer) otherAnswer.style.maxHeight = null;
            if (otherVertical) otherVertical.style.transform = 'rotate(0deg)';
          }
        });
        
        // Toggle current item
        if (isOpen) {
          item.classList.remove('active');
          answer.style.maxHeight = null;
          if (vertical) vertical.style.transform = 'rotate(0deg)';
        } else {
          item.classList.add('active');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          if (vertical) vertical.style.transform = 'rotate(90deg)';
        }
      });
    });

    // Features sticky navigation with active state
    const featureNavLinks = document.querySelectorAll('.feature-nav-link');
    const featureSections = document.querySelectorAll('[id^="feature-"]');

    if (featureSections.length > 0 && featureNavLinks.length > 0) {
      const featureObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            
            // Update all navigation links
            featureNavLinks.forEach(link => {
              const isActive = link.getAttribute('href') === `#${id}`;
              
              if (isActive) {
                // Active state: bold, dark color, visible, colored border
                link.classList.remove('opacity-50', 'text-text-secondary', 'border-transparent', 'font-medium');
                link.classList.add('opacity-100', 'text-text-primary', 'border-brand-primary', 'font-bold');
              } else {
                // Inactive state: normal weight, light color, semi-transparent
                link.classList.remove('opacity-100', 'text-text-primary', 'border-brand-primary', 'font-bold');
                link.classList.add('opacity-50', 'text-text-secondary', 'border-transparent', 'font-medium');
              }
            });
          }
        });
      }, {
        rootMargin: '-40% 0px -60% 0px',
        threshold: 0
      });

      featureSections.forEach(section => {
        featureObserver.observe(section);
      });

      // Smooth scroll for feature links
      featureNavLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.querySelector(link.getAttribute('href'));
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });
    }
  });
</script></main>

